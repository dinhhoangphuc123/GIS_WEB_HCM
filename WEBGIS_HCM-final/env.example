# Đây là BIẾN MÔI TRƯỜNG: đặt trong Render → Environment (app.py không tự đọc file .env).
# Chạy local không cần đặt gì, app dùng DB_CONFIG mặc định như cũ.
# Supabase → Connect → Session pooler (KHÔNG dùng Direct connection vì chỉ có IPv6).
# Username là postgres.<project-ref>, không phải "postgres".
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Domain frontend trên Vercel, nhiều domain cách nhau bằng dấu phẩy. Bỏ trống = cho phép tất cả.
ALLOWED_ORIGINS=https://<ten-app>.vercel.app
